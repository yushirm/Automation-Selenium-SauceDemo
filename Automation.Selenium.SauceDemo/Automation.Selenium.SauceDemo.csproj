<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- FluentAssertions stays on 7.x: version 8 moved to a paid commercial licence. -->
		<PackageReference Include="FluentAssertions" Version="7.2.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
		<PackageReference Include="coverlet.collector" Version="10.1.1" />
		<!-- Selenium Manager (built in since 4.6) downloads the matching ChromeDriver, so no driver package is pinned. -->
		<PackageReference Include="Selenium.Support" Version="4.53.0" />
		<PackageReference Include="Selenium.WebDriver" Version="4.53.0" />
	</ItemGroup>

</Project>
